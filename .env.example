# Zoho Mail / IMAP
UARB_EMAIL_USER=your-agent@example.com
UARB_EMAIL_PASS=your-email-password-or-app-password
UARB_IMAP_HOST=imap.zoho.com
UARB_IMAP_PORT=993
UARB_SMTP_HOST=smtp.zoho.com
UARB_SMTP_PORT=587
UARB_IMAP_FOLDER=INBOX
UARB_IDLE_TIMEOUT_MIN=25

# UARB browser scraper
UARB_BASE_URL=https://uarb.novascotia.ca/fmi/webd/UARB15
UARB_MAX_DOCS=10
UARB_HEADLESS=1
UARB_SLOW_MO=0

# OpenAI-compatible LLM provider
UARB_LLM_BASE_URL=https://opencode.ai/zen/v1
UARB_LLM_MODEL=deepseek-v4-pro
UARB_LLM_API_KEY=your-llm-api-key
